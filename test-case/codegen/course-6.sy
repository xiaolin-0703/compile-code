int trace = 0;

int record(int value) {
    trace = trace * 10 + value;
    return value;
}

int main() {
    printf("24373148\n");
    int first = get_int();
    int second = get_int();
    int result = 0;
    if (record(first) && record(second) && record(3)) {
        result = 1;
    } else {
        result = 2;
    }
    printf("and: trace=%d result=%d\n", trace, result);
    trace = 0;
    if (record(first) || record(second) || record(3)) {
        result = 3;
    } else {
        result = 4;
    }
    printf("or: trace=%d result=%d\n", trace, result);
    return 0;
}
